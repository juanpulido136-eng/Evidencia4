<Window
    x:Class="Productos.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Registrar Producto">

    <ScrollViewer>
        <StackPanel Margin="40,20" Spacing="10">

            <TextBlock Text="Registrar Producto" FontSize="26"
                       FontWeight="SemiBold" HorizontalAlignment="Center"/>

            <TextBox x:Name="txtNombre" Header="Nombre*"/>

            <TextBox x:Name="txtDescripcion" Header="Descripción"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

            <TextBox x:Name="txtMarca" Header="Marca*"/>

            <TextBox x:Name="txtPrecio" Header="Precio* (ej. 12.50)"/>

            <TextBox x:Name="txtExistencias" Header="Existencias* (número entero)"/>

            <DatePicker x:Name="dpFecha" Header="Fecha de lanzamiento"/>

            <TextBlock Text="Imagen"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtImagen" IsReadOnly="True" Grid.Column="0"/>
                <Button Content="Seleccionar imagen..." Grid.Column="1"
                        Click="BtnImagen_Click"/>
            </Grid>

            <Button Content="Registrar Producto" HorizontalAlignment="Center"
                    Margin="0,10,0,0" Click="BtnRegistrar_Click"/>

            <TextBlock x:Name="txtMensaje" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>